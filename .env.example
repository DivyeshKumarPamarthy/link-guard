# LinkGuard configuration (docs/phase1-spec.md §4). Copy to .env and edit; never commit .env.
# Values shown are the defaults.

LG_PROFILE=dev                      # dev | test | demo | prod
LG_HEAD_FETCH_BYTES=5242880         # byte cap per scan (5 MB)
LG_CONNECT_TIMEOUT_S=5
LG_TOTAL_DEADLINE_S=20              # whole scan including redirects
LG_MIN_THROUGHPUT_BPS=1024          # enforced after LG_MIN_THROUGHPUT_GRACE_S
LG_MIN_THROUGHPUT_GRACE_S=5
LG_MAX_RETRY_AFTER_S=5              # a 429 is retried once if Retry-After <= this
LG_MAX_REDIRECTS=5
LG_LONG_CHAIN_HOPS=3                # more redirects than this -> REDIR_LONG_CHAIN
LG_ALLOWED_PORTS=80,443
LG_MAX_URL_LENGTH=2048
LG_MAX_CONCURRENT_SCANS=4
LG_MAX_WAITING_SCANS=20             # beyond this, POST returns 503 SERVER_BUSY
LG_BIND_HOST=127.0.0.1              # must stay loopback (decision D18)
LG_CORS_ORIGINS=*                   # credentials are never allowed
LG_DATABASE_URL=sqlite:///./linkguard.db
LG_USER_AGENT="LinkGuard/1.0 (link safety checker)"
LG_ZIP_MAX_ENTRIES=10000          # ZIP entry names listed at most (D37)
LG_TEXT_SAMPLE_BYTES=4096         # bytes checked when deciding "is this text?" (D37)
LG_TEXT_MIN_PRINTABLE_RATIO=0.95  # share of printable characters needed for text (D37)
LG_SUSPICIOUS_SCORE=30            # score at or above this -> SUSPICIOUS (spec §9)
LG_UNSAFE_SCORE=60                # score at or above this -> UNSAFE (spec §9)

# --- test / demo profiles ONLY. Startup fails if these are set in dev or prod. ---
# LG_STATIC_HOSTS=a.demo.test=127.0.0.1,b.demo.test=127.0.0.1,c.demo.test=127.0.0.1
# LG_SSRF_EXEMPT=a.demo.test:8081,b.demo.test:8081,c.demo.test:8081,a.demo.test:8443,b.demo.test:8443,c.demo.test:8443,a.demo.test:8444
# LG_ALLOWED_PORTS=80,443,8081,8443,8444   # test/demo: add the demo ports
# LG_EXTRA_CA_BUNDLE=demo/certs/test-ca.pem
