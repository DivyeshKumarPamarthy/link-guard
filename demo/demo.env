# Backend settings for `make demo` (scripts/demo.sh): the demo profile of docs/phase1-spec.md §11.
#
# The demo server runs on this computer (127.0.0.1), which the SSRF checks rightly block.
# These lines name the demo hosts and exempt exactly those host:port pairs (decision D2).
# The backend refuses to start with them in the dev or prod profile, and logs each one as a
# WARNING. Paths are relative to backend/, where the API is started.
LG_PROFILE=demo
LG_STATIC_HOSTS=a.demo.test=127.0.0.1,b.demo.test=127.0.0.1,c.demo.test=127.0.0.1
LG_SSRF_EXEMPT=a.demo.test:8081,b.demo.test:8081,c.demo.test:8081,a.demo.test:8443,b.demo.test:8443,c.demo.test:8443,a.demo.test:8444
LG_ALLOWED_PORTS=80,443,8081,8443,8444
LG_EXTRA_CA_BUNDLE=../demo/certs/test-ca.pem
